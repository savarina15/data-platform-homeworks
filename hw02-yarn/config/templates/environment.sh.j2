# Dedicated YARN environment; original Hadoop environment is untouched.
export JAVA_HOME={{ java_home | quote }}
export HADOOP_HOME={{ hadoop_home | quote }}
export HADOOP_CONF_DIR={{ yarn_conf | quote }}
export HADOOP_COMMON_HOME="$HADOOP_HOME" HADOOP_HDFS_HOME="$HADOOP_HOME"
export HADOOP_YARN_HOME="$HADOOP_HOME" HADOOP_MAPRED_HOME="$HADOOP_HOME"
export HADOOP_LOG_DIR={{ (yarn_base ~ '/logs') | quote }}
export HADOOP_PID_DIR={{ (yarn_base ~ '/run') | quote }}
export HADOOP_IDENT_STRING={{ hdfs_user | quote }}
export YARN_LOG_DIR="$HADOOP_LOG_DIR" YARN_PID_DIR="$HADOOP_PID_DIR"
export YARN_IDENT_STRING="$HADOOP_IDENT_STRING"
export HADOOP_HEAPSIZE_MAX={{ yarn_heap_mb }}m
export YARN_RESOURCEMANAGER_OPTS="-Xmx{{ yarn_heap_mb }}m"
export YARN_NODEMANAGER_OPTS="-Xmx{{ yarn_heap_mb }}m"
export MAPRED_HISTORYSERVER_OPTS="-Xmx{{ yarn_heap_mb }}m"
export PATH="$JAVA_HOME/bin:$HADOOP_HOME/bin:$PATH"
